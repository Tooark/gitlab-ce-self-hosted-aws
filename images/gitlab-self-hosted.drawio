        <mxCell id="fix-ext-saml" parent="fix-ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#808080;fontColor=light-dark(#2E2E2E,#F0F0F0);fontSize=12;" value="SAML SSO&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Identity Provider&lt;/font&gt;" vertex="1">
