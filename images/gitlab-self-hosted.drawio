        <mxCell id="fix-ext" parent="sGtHwoEF5G3cdS0aJBlE-97" style="swimlane;whiteSpace=wrap;html=1;fillColor=light-dark(#999999,#4D4D4D);strokeColor=#808080;fontColor=light-dark(#2E2E2E,#F0F0F0);fillStyle=solid;strokeWidth=2;startSize=23;fontSize=12;" value="External integrations" vertex="1">
